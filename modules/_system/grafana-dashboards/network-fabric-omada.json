{
  "description": "SG3210 switch + EAP773 APs: SNMP metrics (device-direct) and device syslog (relayed via the Omada controller).",
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Fabric health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "index": 1,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "up{job=~\"snmp.*\"}",
          "instant": true,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "SNMP targets up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "clientCount",
          "instant": true,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Connected clients (APs)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sysUpTime/100",
          "instant": true,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Device uptime",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "title": "Switch - CoreSwitch (SG3210)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 6,
      "targets": [
        {
          "expr": "rate(ifHCInOctets{host=\"coreswitch\",ifAlias=~\"Port.*\"}[5m])*8",
          "legendFormat": "{{ifAlias}}",
          "refId": "A"
        }
      ],
      "title": "Port throughput - In (bits/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 7,
      "targets": [
        {
          "expr": "rate(ifHCOutOctets{host=\"coreswitch\",ifAlias=~\"Port.*\"}[5m])*8",
          "legendFormat": "{{ifAlias}}",
          "refId": "A"
        }
      ],
      "title": "Port throughput - Out (bits/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 8,
      "targets": [
        {
          "expr": "rate(ifInErrors{host=\"coreswitch\",ifAlias=~\"Port.*\"}[5m]) + rate(ifOutErrors{host=\"coreswitch\",ifAlias=~\"Port.*\"}[5m])",
          "legendFormat": "{{ifAlias}} errors",
          "refId": "A"
        },
        {
          "expr": "rate(ifInDiscards{host=\"coreswitch\",ifAlias=~\"Port.*\"}[5m]) + rate(ifOutDiscards{host=\"coreswitch\",ifAlias=~\"Port.*\"}[5m])",
          "legendFormat": "{{ifAlias}} discards",
          "refId": "B"
        }
      ],
      "title": "Interface errors & discards (/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "options": {
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "Up"
                },
                "2": {
                  "color": "red",
                  "index": 1,
                  "text": "Down"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 9,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "ifOperStatus{host=\"coreswitch\",ifAlias=~\"Port.*\"}",
          "instant": true,
          "legendFormat": "{{ifAlias}}",
          "refId": "A"
        }
      ],
      "title": "Port link state",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 10,
      "title": "Access Points (EAP773)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 11,
      "targets": [
        {
          "expr": "clientCount",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Connected clients over time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 12,
      "targets": [
        {
          "expr": "rate(ifHCInOctets{host=~\"ap-.*\"}[5m])*8",
          "legendFormat": "{{host}} {{ifName}}",
          "refId": "A"
        }
      ],
      "title": "AP throughput - In (bits/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 13,
      "title": "Device logs (relayed via Omada controller)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 14,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "app_name:omada-homeLab",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Device event log (app_name=omada-homeLab)",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "homelab",
    "network",
    "omada",
    "snmp"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Network Fabric - Omada",
  "uid": "omada-fabric",
  "version": 1
}
